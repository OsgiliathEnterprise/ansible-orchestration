apiVersion: v1
kind: Config
clusters:
- cluster:
    certificate-authority-data: "{{ kube_ca_bundle_b64.content }}"
    server: https://{{ kube_master_host }}:6443
  name: default
contexts:
- context:
    cluster: default
    user: kubelet-bootstrap
  name: default
current-context: default
preferences: {}
users:
- name: kubelet-bootstrap
  user:
    token: "{{ kube_join_token }}"
